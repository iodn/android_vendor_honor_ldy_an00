// Stock public MediaTek NPU client libraries. ARM64 only.

cc_prebuilt_library_shared {
    name: "honor_npu_libneuronusdk_adapter_mtk",
    stem: "libneuronusdk_adapter.mtk",
    system_ext_specific: true,
    compile_multilib: "64",
    srcs: ["proprietary/system_ext/lib64/libneuronusdk_adapter.mtk.so"],
    strip: { none: true },
    stl: "none",
    system_shared_libs: [],
    // Stock SONAME is libneuronusdk_adapter.mtk.so.8, while its public filename
    // is libneuronusdk_adapter.mtk.so. Strict separate ABI checks retain the stock
    // SONAME and validate all imports; Soong assumes filename equals SONAME.
    check_elf_files: false,
    shared_libs: [
        "libnativewindow",
        "liblog",
        "libdl",
        "libm",
        "libc",
    ],
}

