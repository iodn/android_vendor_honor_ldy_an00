// Stock TEE integration; image/runtime qualification remains pending.
soong_namespace {}

package {
    default_applicable_licenses: ["honor_ldy_an00_proprietary_license"],
}

license {
    name: "honor_ldy_an00_proprietary_license",
    license_kinds: ["legacy_proprietary"],
}

cc_prebuilt_library_shared {
    name: "honor_libc_secshared",
    stem: "libc_secshared",
    system_ext_specific: true,
    compile_multilib: "64",
    srcs: ["proprietary/system/lib64/libc_secshared.so"],
    strip: {
        none: true,
    },
    check_elf_files: true,
    shared_libs: ["libc++"],
}

cc_prebuilt_library_shared {
    name: "honor_libteec_hidl",
    stem: "vendor.honor.hardware.libteec@3.0",
    system_ext_specific: true,
    compile_multilib: "64",
    srcs: ["proprietary/system/lib64/vendor.honor.hardware.libteec@3.0.so"],
    strip: {
        none: true,
    },
    check_elf_files: true,
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
    ],
}

