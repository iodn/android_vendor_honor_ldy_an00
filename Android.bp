cc_prebuilt_binary {
    name: "honor_tee_auth_daemon",
    stem: "tee_auth_daemon",
    system_ext_specific: true,
    compile_multilib: "64",
    srcs: ["proprietary/system_ext/bin/tee_auth_daemon"],
    strip: {
        none: true,
    },
    check_elf_files: true,
    shared_libs: [
        "libcutils",
        "liblog",
        "libhardware",
        "honor_libc_secshared",
        "libutils",
        "libtinyxml2",
        "libcrypto",
        "libhidlbase",
        "libhidltransport",
        "libhidlmemory",
        "libhwbinder",
        "libbinder",
        "libbinder_ndk",
        "honor_libteec_hidl",
        "honor_libteec_ndk",
        "libc++",
    ],
}

// Stock binary containers read by tee_auth_daemon during IInitializeContext.
// Despite the filename suffix, these are copied as data, not parsed as XML.
prebuilt_etc {
    name: "honor_tee_native_packages_system",
    src: "proprietary/system/etc/native_packages.xml",
    filename: "native_packages.xml",
}

prebuilt_etc {
    name: "honor_tee_native_packages_system_ext",
    system_ext_specific: true,
    src: "proprietary/system_ext/etc/native_packages.xml",
    filename: "native_packages.xml",
}

